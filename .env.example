# Copy to .env and fill in real values. Never commit .env.
# All variables exposed to the browser must be prefixed with VITE_.

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS — order confirmation
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# EmailJS — OTP verification (may use a different account)
VITE_EMAILJS_VERIFICATION_SERVICE_ID=
VITE_EMAILJS_VERIFICATION_TEMPLATE_ID=

# Mapbox
VITE_MAPBOX_TOKEN=
